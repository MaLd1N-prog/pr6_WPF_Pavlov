<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#0078D4"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#005A9E"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#004578"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DangerBackground" Color="#D13438"/>
    <SolidColorBrush x:Key="DangerHover" Color="#A4262C"/>

    <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
    <SolidColorBrush x:Key="BorderColor" Color="#D1D5DB"/>
</ResourceDictionary>